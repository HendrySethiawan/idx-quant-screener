# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environment
.venv/
env/
venv/
ENV/

# Environment Variables
.env

# THIS REPOSITORY IS PUBLIC.
#
# Everything below stays on the local machine. Plain `data/` rather than
# `data/*` plus exceptions: with no file being re-included there is no reason to
# keep the re-inclusion mechanism around, and without it a future edit cannot
# accidentally expose something under data/.
data/
logs/

# Personal state - never publish.
# Comments go on their OWN lines: git does not strip trailing comments, so
# `current_holdings.yaml  # note` is matched literally and silently ignores nothing.
#
#   current_holdings.yaml   your positions and average cost
#   configs/user.yaml       your capital and universe edits
#   configs/events.yaml     your event calendar
current_holdings.yaml
configs/user.yaml
configs/events.yaml


# Models (Keep the directory, ignore the files)
models/*
!models/.gitkeep

# IDEs
.vscode/
.idea/

# OS specific
.DS_Store
Thumbs.db

# PyInstaller build output. The folder is ~150MB and the zip ~60MB, both far past
# what belongs in a git repo - build it with packaging/build.py, ship it as a
# GitHub Release.
build/
dist/
